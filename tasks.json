{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run all scenarios",
      "detail": "Runs run-scenarios.sh with no arguments: logs in, then runs every scenario in scenarios/.",
      "type": "shell",
      "command": "bash",
      "args": [
        "run-scenarios.sh"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run all Playwright tests",
      "detail": "npx playwright test: setup project logs in, then every tests/*.spec.js on chromium/firefox/webkit.",
      "type": "shell",
      "command": "npx",
      "args": [
        "playwright",
        "test"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
